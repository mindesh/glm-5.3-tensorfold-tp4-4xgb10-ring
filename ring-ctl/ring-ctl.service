[Unit]
Description=Switchless ring control path (ctl0 dummy IP routed over QSFP)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs as a throwaway non-root user holding only network-admin rights
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Loading a kernel module needs root: this one fixed line runs privileged ("+")
ExecStartPre=+/usr/sbin/modprobe dummy numdummies=0
ExecStart=/usr/local/sbin/ring-ctl.sh up
ExecReload=/usr/local/sbin/ring-ctl.sh up
ExecStop=/usr/local/sbin/ring-ctl.sh down
# QSFP links can come up after network-online; retry until the next hops exist
Restart=on-failure
RestartSec=10
# exit 78 = config problem (unknown host, iptables-legacy, open FORWARD policy): don't retry. Not 2: ip uses it.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
