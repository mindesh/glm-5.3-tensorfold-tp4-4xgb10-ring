#!/bin/sh
# NetworkManager drops the ctl0 control routes when a QSFP link loses carrier (neighbour reboot); re-add on link up.
# --no-block: at boot the reload would otherwise wait for ring-ctl's start job and stall the dispatcher.
case "$1" in
  enP2p1s0f*) [ "$2" = up ] && systemctl -q is-active ring-ctl && systemctl --no-block reload ring-ctl ;;
esac
exit 0
